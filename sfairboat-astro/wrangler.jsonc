{
  // Cloudflare Workers config.
  // The dashboard build runs `npm run build` (creates ./dist),
  // then `npx wrangler deploy` uploads ./dist plus the small script in ./worker.
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match your Worker's name in the Cloudflare dashboard.
  "name": "sfairboat-astro",
  "compatibility_date": "2025-09-01",

  // Handles /api/reviews (Google reviews). Everything else is static.
  "main": "./worker/index.ts",

  "vars": {
    // Public identifier for the business on Google Maps (safe to commit).
    "GOOGLE_PLACE_ID": "ChIJa0mIKKGV2YgR-eK6OM7ljm4"
  },
  // GOOGLE_PLACES_API_KEY is a SECRET. Add it in the dashboard under
  // Settings > Variables and Secrets (type: Secret). Never put it in this file.

  // Settings for preview (non-production branch) builds, which run
  // `npx wrangler preview`. Variables aren't inherited, so repeat them here.
  // GOOGLE_PLACES_API_KEY must also be added as a Preview secret in the dashboard.
  "previews": {
    "vars": {
      "GOOGLE_PLACE_ID": "ChIJa0mIKKGV2YgR-eK6OM7ljm4"
    }
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the script; static pages skip it entirely.
    "run_worker_first": ["/api/*"]
  }
}
