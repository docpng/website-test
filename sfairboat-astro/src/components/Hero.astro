---
import { business } from "../data/business";
---

<section class="relative overflow-hidden bg-moss-950 text-bone">
  <!-- Subtle sawgrass texture using SVG -->
  <svg
    class="absolute inset-0 w-full h-full opacity-10"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
    viewBox="0 0 1200 600"
  >
    <defs>
      <pattern id="grass" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
        <path d="M10 60 L10 30 M30 60 L30 20 M50 60 L50 35 M20 60 L20 25 M40 60 L40 15" stroke="#c2a35e" stroke-width="1" fill="none" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grass)" />
  </svg>

  <div class="relative max-w-7xl mx-auto px-5 lg:px-8 pt-20 pb-28 lg:pt-28 lg:pb-36">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-10 bg-sand-400"></span>
        <span class="text-xs tracking-[0.2em] uppercase text-sand-300 font-medium">
          Veteran-Owned · Private Tours · Miami, FL
        </span>
      </div>
      <h1 class="text-bone">
        Private Everglades airboat tours, guided by a true Gladesman.
      </h1>
      <p class="mt-6 text-lg text-sand-100 max-w-2xl">
        Fast rides, slow drifts, nighttime fish gigging, Everglades fishing
        trips, and python hunts — all private, all tailored to your group.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <a
          href={business.bookingUrl}
          class="inline-flex items-center bg-sand-400 text-moss-950 px-7 py-3.5 font-medium hover:bg-sand-300 transition"
        >
          Book Your Trip
        </a>
        <a
          href={business.phoneHref}
          class="inline-flex items-center text-bone border border-sand-200/30 px-7 py-3.5 font-medium hover:border-sand-200/60 transition"
        >
          Call {business.phoneDisplay}
        </a>
      </div>

      <!-- Trust strip -->
      <div class="mt-14 grid grid-cols-3 gap-6 max-w-2xl">
        <div>
          <div class="font-display text-3xl text-sand-300">10+</div>
          <div class="text-xs text-sand-200 mt-1">Years guiding the Glades</div>
        </div>
        <div>
          <div class="font-display text-3xl text-sand-300">100%</div>
          <div class="text-xs text-sand-200 mt-1">Private trips, always</div>
        </div>
        <div>
          <div class="font-display text-3xl text-sand-300">24/7</div>
          <div class="text-xs text-sand-200 mt-1">By appointment</div>
        </div>
      </div>
    </div>
  </div>
</section>
