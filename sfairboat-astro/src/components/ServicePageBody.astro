---
// A service page: its layout (built-in parts plus any sections added in the
// site editor), top to bottom.
import type { Service } from "../data/services";
import SectionList from "./sections/SectionList.astro";
import { serviceLayout } from "../data/layouts";
import { fileOf } from "../data/validate";

type Props = { service: Service };
const { service } = Astro.props;
---

<SectionList
  sections={serviceLayout(service)}
  source={`src/content/services/${service.slug}.json`}
  context={{ service }}
  file={fileOf(service)}
  field="layout"
  isDefault={!service.layout?.length}
/>
