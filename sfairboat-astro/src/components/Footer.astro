---
import { business, addressLine } from "../data/business";
import { services } from "../data/services";

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Reviews", href: "/reviews" },
  { label: "FAQs", href: "/faqs" },
  { label: "Gallery", href: "/gallery" },
  { label: "Areas We Serve", href: "/areas-we-serve" },
  { label: "Contact Us", href: "/contact-us" },
];
---

<footer class="bg-moss-950 text-sand-100 mt-24">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="font-display text-xl font-semibold text-bone">
          {business.name}
        </div>
        <p class="mt-4 text-sm text-sand-200 leading-relaxed max-w-xs">
          Veteran-owned, locally run. Private Everglades airboat tours, fishing,
          and python hunts out of Miami.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <a
            href={business.social.facebook}
            aria-label="Facebook"
            class="text-sand-200 hover:text-bone"
            target="_blank"
            rel="noopener"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
          <a
            href={business.social.instagram}
            aria-label="Instagram"
            class="text-sand-200 hover:text-bone"
            target="_blank"
            rel="noopener"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
          </a>
          <a
            href={business.social.google}
            aria-label="Google Business"
            class="text-sand-200 hover:text-bone"
            target="_blank"
            rel="noopener"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-display text-sm font-semibold text-bone tracking-wide">
          Services
        </h3>
        <ul class="mt-4 space-y-2 text-sm">
          {
            services.map((s) => (
              <li>
                <a href={`/${s.slug}`} class="text-sand-200 hover:text-bone">
                  {s.shortName}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="font-display text-sm font-semibold text-bone tracking-wide">
          Quick Links
        </h3>
        <ul class="mt-4 space-y-2 text-sm">
          {
            quickLinks.map((l) => (
              <li>
                <a href={l.href} class="text-sand-200 hover:text-bone">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-display text-sm font-semibold text-bone tracking-wide">
          Contact
        </h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="sr-only">Phone</dt>
            <dd>
              <a href={business.phoneHref} class="text-sand-200 hover:text-bone font-medium">
                {business.phoneDisplay}
              </a>
            </dd>
          </div>
          <div>
            <dt class="sr-only">Address</dt>
            <dd>
              <a
                href={business.googleMapsUrl}
                target="_blank"
                rel="noopener"
                class="text-sand-200 hover:text-bone"
              >
                {addressLine}
              </a>
            </dd>
          </div>
          <div>
            <dt class="sr-only">Hours</dt>
            <dd class="text-sand-200">{business.hours}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-sand-200/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs text-sand-200/70">
      <div>© {new Date().getFullYear()} {business.name}. All rights reserved.</div>
      <div class="flex items-center gap-4">
        <span>Veteran-owned small business</span>
      </div>
    </div>
  </div>
</footer>
