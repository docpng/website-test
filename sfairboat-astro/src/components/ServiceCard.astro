---
import type { Service } from "../data/services";

type Props = { service: Service };
const { service } = Astro.props;

const iconMap = {
  airboat: `<path d="M12 44c8-6 20-6 40 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M16 36l8-12h18l-5 12" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08"/><circle cx="30" cy="28" r="1.5" fill="currentColor"/><path d="M48 36l6-8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  fish: `<path d="M8 32c6-8 18-10 28-6l6-6v24l-6-6c-10 4-22 2-28-6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08"/><circle cx="18" cy="32" r="1.5" fill="currentColor"/>`,
  gig: `<path d="M12 48l20-24 8 8-20 24z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08"/><path d="M36 20l4-4 8 8-4 4" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 52h48" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.4"/>`,
  python: `<path d="M12 20c6 0 6 8 12 8s6-8 12-8 6 8 12 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/><path d="M12 32c6 0 6 8 12 8s6-8 12-8 6 8 12 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/><circle cx="14" cy="20" r="2" fill="currentColor"/>`,
};
---

<article class="group border border-moss-900/10 bg-bone p-7 hover:border-moss-600 transition">
  <div class="flex items-start justify-between">
    <svg
      viewBox="0 0 64 64"
      class="w-14 h-14 text-moss-700"
      fill="none"
      aria-hidden="true"
      set:html={iconMap[service.icon]}
    />
    <span class="text-xs text-moss-600 uppercase tracking-wider">
      {service.schemaCategory}
    </span>
  </div>
  <h3 class="mt-6 text-moss-950">{service.name}</h3>
  <p class="mt-3 text-sm text-moss-800">{service.summary}</p>
  <a
    href={`/${service.slug}`}
    class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-moss-900 border-b border-moss-900 pb-0.5 group-hover:text-moss-600 group-hover:border-moss-600"
  >
    Learn more
    <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8h10m-4-4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</article>
