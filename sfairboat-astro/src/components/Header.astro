---
import { business } from "../data/business";
import { services } from "../data/services";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const navItems = [
  { label: "Home", href: "/" },
  {
    label: "Services",
    href: "#",
    children: services.map((s) => ({
      label: s.shortName,
      href: `/${s.slug}`,
    })),
  },
  { label: "Reviews", href: "/reviews" },
  { label: "FAQs", href: "/faqs" },
  { label: "Gallery", href: "/gallery" },
  { label: "Areas We Serve", href: "/areas-we-serve" },
  { label: "Contact", href: "/contact-us" },
];
---

<header class="border-b border-moss-900/10 bg-bone sticky top-0 z-40 backdrop-blur">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0" aria-label={`${business.name} home`}>
        <Image
          src={logo}
          alt={business.name}
          height={72}
          densities={[1, 2, 3]}
          loading="eager"
          fetchpriority="high"
          class="h-16 lg:h-[72px] w-auto"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-7" aria-label="Main">
        {
          navItems.map((item) =>
            item.children ? (
              <div class="relative group" data-dropdown>
                <button
                  type="button"
                  data-dropdown-toggle
                  class="text-sm font-medium text-moss-900 hover:text-moss-600 py-2 inline-flex items-center gap-1"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="services-menu"
                >
                  {item.label}
                  <svg class="w-3 h-3 transition group-data-[open]:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <!-- Opened/closed by the script at the bottom of this file (works for tap, click, hover, and keyboard) -->
                <div id="services-menu" class="absolute top-full left-0 pt-2 opacity-0 invisible group-data-[open]:opacity-100 group-data-[open]:visible transition">
                  <div class="bg-bone border border-moss-900/10 shadow-lg min-w-[220px] py-2">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="block px-4 py-2 text-sm text-moss-900 hover:bg-sand-100"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="text-sm font-medium text-moss-900 hover:text-moss-600 py-2"
              >
                {item.label}
              </a>
            )
          )
        }
      </nav>

      <!-- Phone + CTA -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href={business.phoneHref}
          class="text-sm font-semibold text-moss-900 hover:text-moss-600"
        >
          {business.phoneDisplay}
        </a>
        <a
          href={business.bookingUrl}
          class="inline-flex items-center bg-moss-900 text-bone px-5 py-2.5 text-sm font-medium hover:bg-moss-800 transition"
        >
          Book Now
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        id="mobile-toggle"
        class="lg:hidden p-2 -mr-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-6 h-6 text-moss-900"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <nav
      id="mobile-menu"
      class="lg:hidden hidden pb-6 pt-2 border-t border-moss-900/10"
      aria-label="Mobile"
    >
      <ul class="space-y-1">
        {
          navItems.map((item) =>
            item.children ? (
              <li>
                <div class="px-2 py-2 text-sm font-semibold text-moss-700">
                  {item.label}
                </div>
                <ul class="pl-4 space-y-1">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-2 py-2 text-sm text-moss-900 hover:bg-sand-100"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="block px-2 py-2 text-sm font-medium text-moss-900 hover:bg-sand-100"
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <div class="mt-4 flex flex-col gap-3 px-2">
        <a
          href={business.phoneHref}
          class="text-sm font-semibold text-moss-900"
        >
          Call {business.phoneDisplay}
        </a>
        <a
          href={business.bookingUrl}
          class="inline-flex items-center justify-center bg-moss-900 text-bone px-5 py-3 text-sm font-medium"
        >
          Book Now
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  // Desktop "Services" dropdown.
  // Tap/click toggles it (iPad, phones, mouse). A mouse also opens it on hover.
  // Tapping outside, pressing Escape, or tabbing away closes it.
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
    const button = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
    if (!button) return;

    let openedByHover = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const isOpen = () => dropdown.hasAttribute("data-open");
    const setOpen = (open: boolean) => {
      dropdown.toggleAttribute("data-open", open);
      button.setAttribute("aria-expanded", String(open));
      if (!open) openedByHover = false;
    };

    button.addEventListener("click", () => {
      if (openedByHover) {
        // Menu was opened by hovering; a click keeps it open instead of closing it.
        openedByHover = false;
        return;
      }
      setOpen(!isOpen());
    });

    // Hover only for a real mouse; touch taps are handled by "click" above.
    dropdown.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      clearTimeout(closeTimer);
      if (!isOpen()) {
        setOpen(true);
        openedByHover = true;
      }
    });
    dropdown.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse" || !openedByHover) return;
      closeTimer = setTimeout(() => setOpen(false), 150);
    });

    // Keyboard: Escape closes; tabbing out of the menu closes it.
    dropdown.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });
    dropdown.addEventListener("focusout", (e) => {
      if (!dropdown.contains(e.relatedTarget as Node | null)) setOpen(false);
    });

    // Tap or click anywhere else closes it. "pointerdown" is used because
    // iOS Safari doesn't send "click" events from plain page areas.
    document.addEventListener("pointerdown", (e) => {
      if (isOpen() && !dropdown.contains(e.target as Node)) setOpen(false);
    });
  });
</script>
