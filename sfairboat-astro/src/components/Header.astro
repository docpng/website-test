---
import { business } from "../data/business";
import { services } from "../data/services";

const navItems = [
  { label: "Home", href: "/" },
  {
    label: "Services",
    href: "#",
    children: services.map((s) => ({
      label: s.shortName,
      href: `/${s.slug}`,
    })),
  },
  { label: "Reviews", href: "/reviews" },
  { label: "FAQs", href: "/faqs" },
  { label: "Gallery", href: "/gallery" },
  { label: "Areas We Serve", href: "/areas-we-serve" },
  { label: "Contact", href: "/contact-us" },
];
---

<header class="border-b border-moss-900/10 bg-bone sticky top-0 z-40 backdrop-blur">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <svg
          viewBox="0 0 48 48"
          class="w-10 h-10 text-moss-800"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M8 32c6-4 12-4 16-4s10 0 16 4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
          <path
            d="M14 28l6-10h12l-4 10"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
            fill="currentColor"
            fill-opacity="0.1"></path>
          <circle cx="24" cy="22" r="1.5" fill="currentColor"></circle>
          <path d="M8 36h32" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"></path>
          <path d="M12 40h24" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"></path>
        </svg>
        <div class="hidden sm:block">
          <div class="font-display text-lg font-semibold leading-tight text-moss-900">
            South Florida
          </div>
          <div class="font-display text-sm leading-tight text-moss-600 tracking-wide">
            Airboat Adventures
          </div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-7" aria-label="Main">
        {
          navItems.map((item) =>
            item.children ? (
              <div class="relative group">
                <button
                  class="text-sm font-medium text-moss-900 hover:text-moss-600 py-2 inline-flex items-center gap-1"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {item.label}
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition">
                  <div class="bg-bone border border-moss-900/10 shadow-lg min-w-[220px] py-2">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="block px-4 py-2 text-sm text-moss-900 hover:bg-sand-100"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="text-sm font-medium text-moss-900 hover:text-moss-600 py-2"
              >
                {item.label}
              </a>
            )
          )
        }
      </nav>

      <!-- Phone + CTA -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href={business.phoneHref}
          class="text-sm font-semibold text-moss-900 hover:text-moss-600"
        >
          {business.phoneDisplay}
        </a>
        <a
          href={business.bookingUrl}
          class="inline-flex items-center bg-moss-900 text-bone px-5 py-2.5 text-sm font-medium hover:bg-moss-800 transition"
        >
          Book Now
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        id="mobile-toggle"
        class="lg:hidden p-2 -mr-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-6 h-6 text-moss-900"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <nav
      id="mobile-menu"
      class="lg:hidden hidden pb-6 pt-2 border-t border-moss-900/10"
      aria-label="Mobile"
    >
      <ul class="space-y-1">
        {
          navItems.map((item) =>
            item.children ? (
              <li>
                <div class="px-2 py-2 text-sm font-semibold text-moss-700">
                  {item.label}
                </div>
                <ul class="pl-4 space-y-1">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-2 py-2 text-sm text-moss-900 hover:bg-sand-100"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="block px-2 py-2 text-sm font-medium text-moss-900 hover:bg-sand-100"
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <div class="mt-4 flex flex-col gap-3 px-2">
        <a
          href={business.phoneHref}
          class="text-sm font-semibold text-moss-900"
        >
          Call {business.phoneDisplay}
        </a>
        <a
          href={business.bookingUrl}
          class="inline-flex items-center justify-center bg-moss-900 text-bone px-5 py-3 text-sm font-medium"
        >
          Book Now
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
