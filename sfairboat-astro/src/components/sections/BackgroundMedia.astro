---
// Background photo or silent looping video behind a section, darkened so
// text on top stays readable. Renders nothing if the file is missing.
import { existsSync } from "node:fs";

type Props = {
  media?: "video" | "image" | "none" | "";
  video?: string;
  mobileVideo?: string; // optional smaller file for phones
  poster?: string;
  image?: string;
  overlay?: "light" | "medium" | "strong" | "";
  id?: string;
};
const { media, video, mobileVideo, poster, image, overlay, id } = Astro.props;

// Only show media that actually exists, so a missing file never shows a broken player.
const fileExists = (src?: string) =>
  Boolean(src) && (/^https?:\/\//.test(src!) || existsSync(`public${src}`));
const showVideo = media === "video" && fileExists(video);
const showImage = media === "image" && fileExists(image);
const showMobile = showVideo && fileExists(mobileVideo);

const overlays = {
  light: "absolute inset-0 bg-moss-950/35",
  medium: "absolute inset-0 bg-moss-950/55",
  strong: "absolute inset-0 bg-moss-950/75",
};
const overlayClass = overlays[overlay || "medium"];
---

{
  (showVideo || showImage) && (
    <>
      {showVideo ? (
        <>
          {/* Background video: silent loop */}
          <video
            id={id}
            class="absolute inset-0 w-full h-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster={poster || undefined}
            aria-hidden="true"
          >
            {/* Browsers download only the first source that matches: phones get the smaller file */}
            {showMobile ? (
              <>
                <source src={video} type="video/mp4" media="(min-width: 768px)" />
                <source src={mobileVideo} type="video/mp4" />
              </>
            ) : (
              <source src={video} type="video/mp4" />
            )}
          </video>
        </>
      ) : (
        <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
      )}
      {/* Darkens the background so the text stays readable */}
      <div class={overlayClass} aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-moss-950/80 via-moss-950/30 to-transparent" aria-hidden="true"></div>
    </>
  )
}

<script>
  // Show only the still image for visitors who prefer reduced motion.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((video) => {
      video.removeAttribute("autoplay");
      video.pause();
    });
  }
</script>

