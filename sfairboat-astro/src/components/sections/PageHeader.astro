---
// Dark title band at the top of inner pages.
import { fill, spacingOf, type SectionSettings } from "./styles";

type Props = { section: SectionSettings & { eyebrow?: string; title: string; intro?: string } };
const { section: s } = Astro.props;

const padding = {
  none: "py-8",
  compact: "py-10 lg:py-14",
  normal: "py-16 lg:py-24",
  roomy: "py-24 lg:py-32",
}[spacingOf(s)];
const widths = { narrow: "max-w-4xl", medium: "max-w-5xl", wide: "max-w-7xl", full: "max-w-none" };
const center = s.align === "center";
const background = s.background === "brand" ? "bg-moss-800 text-bone" : "bg-moss-900 text-bone";
---

<section id={s.anchor || undefined} class={background}>
  <div class={`${widths[s.width || "wide"]} mx-auto px-5 lg:px-8 ${padding}${center ? " text-center" : ""}`}>
    {
      s.eyebrow && (
        <div class={center ? "flex items-center justify-center gap-3 mb-5" : "flex items-center gap-3 mb-5"}>
          <span class="h-px w-10 bg-sand-400" />
          <span class="text-xs tracking-[0.2em] uppercase text-sand-300 font-medium">
            {fill(s.eyebrow)}
          </span>
        </div>
      )
    }
    <h1 class={center ? "text-bone max-w-4xl mx-auto" : "text-bone max-w-4xl"}>{fill(s.title)}</h1>
    {s.intro && <p class={center ? "mt-6 text-lg text-sand-100 max-w-3xl mx-auto" : "mt-6 text-lg text-sand-100 max-w-3xl"}>{fill(s.intro)}</p>}
  </div>
</section>
