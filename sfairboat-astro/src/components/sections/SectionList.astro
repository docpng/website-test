---
// Renders a page's sections in order. Section types and their fields are
// set up for the editor in public/admin/config.yml.
import Hero from "./Hero.astro";
import PageHeader from "./PageHeader.astro";
import Text from "./Text.astro";
import Image from "./Image.astro";
import Video from "./Video.astro";
import ImageText from "./ImageText.astro";
import Features from "./Features.astro";
import ServicesGrid from "./ServicesGrid.astro";
import Faq from "./Faq.astro";
import Areas from "./Areas.astro";
import Gallery from "./Gallery.astro";
import Reviews from "./Reviews.astro";
import Contact from "./Contact.astro";
import Cta from "./Cta.astro";
import Map from "./Map.astro";
import Spacer from "./Spacer.astro";
import ServiceHero from "./parts/ServiceHero.astro";
import ServiceOverview from "./parts/ServiceOverview.astro";
import ServiceDetails from "./parts/ServiceDetails.astro";
import ServiceFaq from "./parts/ServiceFaq.astro";
import OtherServices from "./parts/OtherServices.astro";
import AreaHero from "./parts/AreaHero.astro";
import AreaPitch from "./parts/AreaPitch.astro";
import AreaServices from "./parts/AreaServices.astro";
import AreaLogistics from "./parts/AreaLogistics.astro";
import { validateSection, type Section, type SectionContext } from "../../data/sections";

type Props = { sections?: Section[]; source: string; context?: SectionContext };
const { sections = [], source, context = {} } = Astro.props;

const components: Record<string, any> = {
  hero: Hero,
  pageHeader: PageHeader,
  text: Text,
  image: Image,
  video: Video,
  imageText: ImageText,
  features: Features,
  servicesGrid: ServicesGrid,
  faq: Faq,
  areas: Areas,
  gallery: Gallery,
  reviews: Reviews,
  contact: Contact,
  cta: Cta,
  map: Map,
  spacer: Spacer,
};

// Built-in parts of service and city pages
const parts: Record<string, any> = {
  "servicePart:hero": ServiceHero,
  "servicePart:overview": ServiceOverview,
  "servicePart:details": ServiceDetails,
  "servicePart:faq": ServiceFaq,
  "servicePart:others": OtherServices,
  "areaPart:hero": AreaHero,
  "areaPart:pitch": AreaPitch,
  "areaPart:services": AreaServices,
  "areaPart:logistics": AreaLogistics,
};

const items = sections.map((section, i) => {
  validateSection(section, `${source} (section #${i + 1})`, context);
  const Component = components[section.type] ?? parts[`${section.type}:${section.part}`];
  return { Component, section };
});
---

{items.map(({ Component, section }) => <Component section={section} context={context} />)}
