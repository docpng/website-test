---
// Live Google reviews (loaded by worker/index.ts at /api/reviews).
import Section from "./Section.astro";
import { business } from "../../data/business";
import type { SectionSettings } from "./styles";

type Props = { section: SectionSettings };
const { section: s } = Astro.props;

const starPath =
  "M10 2l2.47 5 5.53.8-4 3.9.94 5.5L10 14.6l-4.94 2.6L6 11.7 2 7.8l5.53-.8L10 2z";
---

<Section settings={s}>
  <!-- Rating summary (filled in once reviews load) -->
  <div id="reviews-summary" class="hidden flex-col sm:flex-row sm:items-center gap-6 mb-10">
    <div class="flex items-center gap-5">
      <div id="summary-rating" class="font-display text-5xl text-moss-900"></div>
      <div>
        <div id="summary-stars" class="flex items-center gap-1 text-sand-500"></div>
        <div id="summary-count" class="text-sm text-moss-800 mt-1"></div>
      </div>
    </div>
    <div class="sm:ml-auto flex flex-col sm:flex-row gap-3">
      <a
        id="all-reviews-link"
        href={business.googleMapsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex justify-center border border-moss-900 text-moss-900 px-5 py-2.5 text-sm hover:bg-sand-100"
      >
        Read all reviews on Google
      </a>
      <a
        href={business.googleReviewUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex justify-center bg-moss-900 text-bone px-5 py-2.5 text-sm hover:bg-moss-800"
      >
        <span style="color: white;"> Leave us a review </span>
      </a>
    </div>
  </div>

  <!-- Review cards. Loading placeholders are replaced by the script below. -->
  <div
    id="reviews-grid"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
    aria-busy="true"
  >
    {
      [1, 2, 3].map(() => (
        <div class="bg-bone border border-moss-900/10 p-7 animate-pulse" aria-hidden="true">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-sand-100" />
            <div class="h-4 w-32 bg-sand-100" />
          </div>
          <div class="mt-5 space-y-2">
            <div class="h-3 bg-sand-100" />
            <div class="h-3 bg-sand-100" />
            <div class="h-3 w-2/3 bg-sand-100" />
          </div>
        </div>
      ))
    }
  </div>

  <!-- Shown only if reviews can't be loaded -->
  <div id="reviews-fallback" class="hidden border border-moss-900/10 bg-sand-50 p-8 text-center">
    <h2 class="text-moss-950">See what guests are saying</h2>
    <p class="mt-3 text-moss-800 mx-auto">
      Our reviews live on Google. Take a look, and if you've been out with us, we'd love to hear from you too.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row justify-center gap-3">
      <a
        href={business.googleMapsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex justify-center border border-moss-900 text-moss-900 px-5 py-2.5 text-sm hover:bg-sand-100"
      >
        Read our reviews on Google
      </a>
      <a
        href={business.googleReviewUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex justify-center bg-moss-900 text-bone px-5 py-2.5 text-sm hover:bg-moss-800"
      >
        <span style="color: white;"> Leave us a review </span>
      </a>
    </div>
  </div>

  <!-- Google attribution (required by the Places API terms) -->
  <div id="reviews-attribution" class="hidden mt-8 items-center gap-2 text-xs text-moss-600">
    <span>Showing Google's most relevant reviews. Reviews and ratings from</span>
    <img
      src="/images/google-maps-logo.svg"
      alt="Google Maps"
      class="h-4 w-auto"
      onerror="this.replaceWith(Object.assign(document.createElement('span'), { textContent: 'Google Maps', className: 'font-medium' }))"
    />
  </div>
</Section>

<script define:vars={{ starPath }}>
  const grid = document.getElementById("reviews-grid");
  const summary = document.getElementById("reviews-summary");
  const fallback = document.getElementById("reviews-fallback");
  const attribution = document.getElementById("reviews-attribution");

  // Only allow real https links from the API (never javascript: etc.)
  const safeUrl = (u) => (typeof u === "string" && u.startsWith("https://") ? u : null);

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text; // textContent, never innerHTML, for review text
    return node;
  }

  function stars(rating, sizeClass) {
    const wrap = el("div", "flex items-center gap-1 text-sand-500");
    const filled = Math.round(Number(rating) || 0);
    wrap.setAttribute("role", "img");
    wrap.setAttribute("aria-label", `${filled} out of 5 stars`);
    for (let i = 0; i < 5; i++) {
      const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.setAttribute("viewBox", "0 0 20 20");
      svg.setAttribute("class", sizeClass);
      svg.setAttribute("fill", i < filled ? "currentColor" : "none");
      svg.setAttribute("stroke", "currentColor");
      svg.setAttribute("aria-hidden", "true");
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", starPath);
      path.setAttribute("stroke-width", "1.5");
      path.setAttribute("stroke-linejoin", "round");
      svg.appendChild(path);
      wrap.appendChild(svg);
    }
    return wrap;
  }

  function reviewCard(r) {
    const card = el("article", "bg-bone border border-moss-900/10 p-7 flex flex-col");

    // Author (name, photo, and link are required attribution)
    const header = el("div", "flex items-center gap-3");
    const photo = safeUrl(r.authorPhoto);
    if (photo) {
      const img = el("img", "w-10 h-10 rounded-full object-cover");
      img.src = photo;
      img.alt = "";
      img.loading = "lazy";
      img.referrerPolicy = "no-referrer";
      header.appendChild(img);
    }
    const who = el("div");
    const authorUrl = safeUrl(r.authorUrl);
    const name = el(authorUrl ? "a" : "span", "font-semibold text-moss-900 hover:underline", r.author);
    if (authorUrl) {
      name.href = authorUrl;
      name.target = "_blank";
      name.rel = "noopener";
    }
    who.appendChild(name);
    if (r.relativeTime) who.appendChild(el("div", "text-xs text-moss-600 mt-0.5", r.relativeTime));
    header.appendChild(who);
    card.appendChild(header);

    if (r.rating) {
      const s = stars(r.rating, "w-4 h-4");
      s.classList.add("mt-4");
      card.appendChild(s);
    }

    // Review text, with "Read more" for long reviews
    const text = el("p", "mt-4 text-moss-900 whitespace-pre-line", r.text);
    card.appendChild(text);
    if (r.text.length > 320) {
      text.classList.add("line-clamp-6");
      const toggle = el("button", "mt-2 self-start text-sm font-semibold text-moss-700 hover:underline", "Read more");
      toggle.type = "button";
      toggle.addEventListener("click", () => {
        const clamped = text.classList.toggle("line-clamp-6");
        toggle.textContent = clamped ? "Read more" : "Show less";
      });
      card.appendChild(toggle);
    }

    const reviewUrl = safeUrl(r.reviewUrl);
    if (reviewUrl) {
      const link = el("a", "mt-auto pt-5 text-xs text-moss-600 hover:text-moss-900", "View on Google");
      link.href = reviewUrl;
      link.target = "_blank";
      link.rel = "noopener";
      card.appendChild(link);
    }
    return card;
  }

  function showFallback() {
    grid.remove();
    fallback.classList.remove("hidden");
  }

  async function loadReviews() {
    try {
      const res = await fetch("/api/reviews", { headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!Array.isArray(data.reviews) || data.reviews.length === 0) throw new Error("No reviews");

      // Summary
      if (data.rating) {
        document.getElementById("summary-rating").textContent = Number(data.rating).toFixed(1);
        document.getElementById("summary-stars").replaceWith(stars(data.rating, "w-5 h-5"));
        document.getElementById("summary-count").textContent =
          `Based on ${data.count} Google review${data.count === 1 ? "" : "s"}`;
      }
      const mapsUrl = safeUrl(data.mapsUrl);
      if (mapsUrl) document.getElementById("all-reviews-link").href = mapsUrl;
      summary.classList.remove("hidden");
      summary.classList.add("flex");

      // Cards
      grid.replaceChildren(...data.reviews.map(reviewCard));
      grid.setAttribute("aria-busy", "false");

      attribution.classList.remove("hidden");
      attribution.classList.add("flex");
    } catch (err) {
      console.warn("Reviews unavailable:", err);
      showFallback();
    }
  }

  loadReviews();
</script>
