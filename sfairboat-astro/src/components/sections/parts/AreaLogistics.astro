---
// City page: dock address and drive time.
import { business } from "../../../data/business";
import type { SectionSettings } from "../styles";
import type { SectionContext } from "../../../data/sections";

type Props = { section: SectionSettings; context: SectionContext };
const area = Astro.props.context.area!;
---

<!-- Logistics -->
<section class="py-20 lg:py-24">
  <div class="max-w-5xl mx-auto px-5 lg:px-8">
    <h2 class="text-moss-950 mb-8">Getting here from {area.city}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        <div class="text-xs tracking-[0.2em] uppercase text-moss-600 mb-2">
          Our dock
        </div>
        <div class="font-display text-xl text-moss-950">
          {business.address.street}<br />
          {business.address.city}, {business.address.region} {business.address.postalCode}
        </div>
        <a
          href={business.googleMapsUrl}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-block text-sm font-semibold text-moss-900 border-b border-moss-900"
        >
          Open in Google Maps →
        </a>
      </div>
      <div>
        <div class="text-xs tracking-[0.2em] uppercase text-moss-600 mb-2">
          Drive from {area.city}
        </div>
        <div class="font-display text-xl text-moss-950">{area.driveTime}</div>
        <p class="mt-3 text-sm text-moss-800">
          Parking available on site. Call ahead if you're arriving outside normal hours.
        </p>
      </div>
    </div>
  </div>
</section>
