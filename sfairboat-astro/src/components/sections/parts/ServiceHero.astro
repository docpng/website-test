---
// Service page: title band with trip details and booking buttons.
import { business } from "../../../data/business";
import type { SectionSettings } from "../styles";
import type { SectionContext } from "../../../data/sections";

type Props = { section: SectionSettings; context: SectionContext };
const service = Astro.props.context.service!;

// Optional trip details (price, group size, season) shown under the tagline
const tripDetails = [
  service.price != null && { label: "Price", value: `$${service.price.toLocaleString("en-US")} per trip` },
  service.maxGuests != null && { label: "Group size", value: `Up to ${service.maxGuests} guests` },
  service.season && { label: "Season", value: service.season },
].filter(Boolean) as { label: string; value: string }[];
---

<!-- Hero -->
<section class="bg-moss-900 text-bone">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-16 lg:py-24">
    <nav class="text-xs text-sand-200 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-bone">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-bone">{service.shortName}</li>
      </ol>
    </nav>
    <div class="flex items-center gap-3 mb-5">
      <span class="h-px w-10 bg-sand-400"></span>
      <span class="text-xs tracking-[0.2em] uppercase text-sand-300 font-medium">
        {service.schemaCategory}
      </span>
    </div>
    <h1 class="text-bone max-w-4xl">{service.name}</h1>
    <p class="mt-6 text-lg text-sand-100 max-w-3xl">{service.tagline}</p>
    {
      tripDetails.length > 0 && (
        <dl class="mt-8 flex flex-wrap gap-3">
          {tripDetails.map((d) => (
            <div class="border border-sand-200/25 px-4 py-2.5">
              <dt class="text-[11px] tracking-[0.15em] uppercase text-sand-300">{d.label}</dt>
              <dd class="text-sm text-bone font-medium mt-0.5">{d.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <div class="mt-10 flex flex-col sm:flex-row gap-4">
      <a
        href={business.bookingUrl}
        class="inline-flex items-center bg-sand-400 text-moss-950 px-7 py-3.5 font-medium hover:bg-sand-300"
      >
        Book {service.shortName}
      </a>
      <a
        href={business.phoneHref}
        class="inline-flex items-center text-bone border border-sand-200/30 px-7 py-3.5 font-medium hover:border-sand-200/60"
      >
        Call {business.phoneDisplay}
      </a>
    </div>
  </div>
</section>
