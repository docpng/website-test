---
// Service page: description paragraphs and the "Trip highlights" box.
import type { SectionSettings } from "../styles";
import type { SectionContext } from "../../../data/sections";

type Props = { section: SectionSettings; context: SectionContext };
const service = Astro.props.context.service!;
---

<!-- Overview + highlights -->
<section class="py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7">
      <div class="text-xs tracking-[0.2em] uppercase text-moss-600 font-medium mb-3">
        Overview
      </div>
      <h2 class="text-moss-950">What to expect</h2>
      <div class="mt-6 space-y-5 text-moss-800">
        {service.longDescription.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <aside class="lg:col-span-5">
      <div class="bg-sand-50 border border-moss-900/10 p-7">
        <h3 class="text-moss-950">Trip highlights</h3>
        <ul class="mt-5 space-y-3">
          {
            service.highlights.map((h) => (
              <li class="flex items-start gap-3 text-sm text-moss-900">
                <svg class="w-4 h-4 mt-1 shrink-0 text-moss-600" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</section>
