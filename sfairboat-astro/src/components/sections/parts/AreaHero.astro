---
// City page: title band with intro and drive time.
import type { SectionSettings } from "../styles";
import type { SectionContext } from "../../../data/sections";

type Props = { section: SectionSettings; context: SectionContext };
const area = Astro.props.context.area!;
---

<!-- Hero -->
<section class="bg-moss-900 text-bone">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-16 lg:py-24">
    <nav class="text-xs text-sand-200 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="hover:text-bone">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/areas-we-serve" class="hover:text-bone">Areas We Serve</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-bone">{area.city}, {area.stateAbbr}</li>
      </ol>
    </nav>
    <div class="flex items-center gap-3 mb-5">
      <span class="h-px w-10 bg-sand-400"></span>
      <span class="text-xs tracking-[0.2em] uppercase text-sand-300 font-medium">
        Serving {area.city}, {area.stateAbbr}
      </span>
    </div>
    <h1 class="text-bone max-w-4xl">
      Everglades airboat tours & fishing for {area.city}
    </h1>
    <p class="mt-6 text-lg text-sand-100 max-w-3xl">{area.intro}</p>
    <div class="mt-8 inline-flex items-center gap-3 text-sm text-sand-200">
      <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z" fill="currentColor"/>
      </svg>
      {area.driveTime}
    </div>
  </div>
</section>
