---
// City page: the services offered, as cards.
import { services } from "../../../data/services";
import type { SectionSettings } from "../styles";
import type { SectionContext } from "../../../data/sections";

type Props = { section: SectionSettings; context: SectionContext };
const area = Astro.props.context.area!;
---

<!-- Services -->
<section class="bg-sand-50 py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 class="text-moss-950 mb-10">
      What we offer {area.city} guests
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        services.map((s) => (
          <a
            href={`/${s.slug}`}
            class="group bg-bone border border-moss-900/10 p-7 hover:border-moss-600 transition"
          >
            <h3 class="text-moss-950">{s.shortName}</h3>
            <p class="mt-3 text-sm text-moss-800">{s.summary}</p>
            <div class="mt-5 text-sm font-semibold text-moss-900 group-hover:text-moss-600">
              Learn more →
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
