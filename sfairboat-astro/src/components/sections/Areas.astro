---
// Grid of the cities we serve (from the Service Areas collection).
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
import { serviceAreas } from "../../data/service-areas";
import { business } from "../../data/business";
import { isDark, type SectionSettings } from "./styles";

type Props = { section: SectionSettings & { eyebrow?: string; heading?: string; style?: "tiles" | "cards" } };
const { section: s } = Astro.props;
const dark = isDark(s);
const cards = s.style === "cards";
---

<Section settings={s}>
  <SectionHeading eyebrow={s.eyebrow} heading={s.heading} dark={dark} headingClass="mb-10" />
  {
    cards ? (
      <div class={s.align === "center" ? "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 text-left" : "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"}>
        <div class="border border-moss-900/10 p-7 bg-moss-900 text-bone">
          <div class="text-xs tracking-[0.2em] uppercase text-sand-300 mb-3">
            Home base
          </div>
          <h3 class="text-bone">{business.address.city}, {business.address.region}</h3>
          <p class="mt-3 text-sm text-sand-100">
            Our dock is at {business.address.street}, {business.address.city},
            {business.address.region} {business.address.postalCode}.
          </p>
          <a
            href={business.googleMapsUrl}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex text-sm font-semibold text-sand-300 border-b border-sand-300 pb-0.5"
          >
            Open in Maps →
          </a>
        </div>
        {serviceAreas.map((a) => (
          <a
            href={`/service-area/${a.slug}`}
            class="group border border-moss-900/10 p-7 bg-bone hover:border-moss-600 transition"
          >
            <div class="text-xs tracking-[0.2em] uppercase text-moss-600 mb-3">
              {a.driveTime}
            </div>
            <h3 class="text-moss-950">
              {a.city}, {a.stateAbbr}
            </h3>
            <p class="mt-3 text-sm text-moss-800 line-clamp-3">{a.intro}</p>
            <div class="mt-5 text-sm font-semibold text-moss-900 group-hover:text-moss-600">
              See details →
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class={s.align === "center" ? "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 text-left" : "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3"}>
        <div class="border border-moss-900/10 p-4 bg-moss-900 text-bone">
          <div class="font-display text-lg">{business.address.city}, {business.address.region}</div>
          <div class="text-xs text-sand-200 mt-1">Our home base</div>
        </div>
        {serviceAreas.map((a) => (
          <a
            href={`/service-area/${a.slug}`}
            class="border border-moss-900/10 p-4 bg-bone hover:border-moss-600 transition group"
          >
            <div class="font-display text-lg text-moss-950">
              {a.city}, {a.stateAbbr}
            </div>
            <div class="text-xs text-moss-600 mt-1 group-hover:text-moss-800">
              View area →
            </div>
          </a>
        ))}
      </div>
    )
  }
</Section>
