---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicePageBody from "../components/ServicePageBody.astro";
import { getService } from "../data/services";
import {
  serviceSchema,
  breadcrumbSchema,
  faqPageSchema,
} from "../data/schema";
import { business } from "../data/business";
import { faqs } from "../data/faqs";

const service = getService("fish-gigging")!;
const relevant = faqs.filter((f) =>
  ["fishing", "tours", "logistics"].includes(f.category)
);

const schemas = [
  serviceSchema(service),
  breadcrumbSchema([
    { name: "Home", url: business.siteUrl },
    { name: service.shortName, url: `${business.siteUrl}/${service.slug}` },
  ]),
  faqPageSchema(relevant),
];
---

<BaseLayout
  title={service.seoTitle}
  description={service.metaDescription}
  schema={schemas}
>
  <ServicePageBody service={service} />
</BaseLayout>
