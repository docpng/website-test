---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionList from "../../components/sections/SectionList.astro";
import { areaLayout } from "../../data/layouts";
import { shownFaqs } from "../../data/faq-sections";
import { serviceAreas } from "../../data/service-areas";
import { business } from "../../data/business";
import {
  serviceAreaSchema,
  breadcrumbSchema,
  faqPageSchema,
} from "../../data/schema";

export function getStaticPaths() {
  return serviceAreas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const faqsOnPage = shownFaqs(areaLayout(area));

const schemas = [
  serviceAreaSchema(area.slug)!,
  breadcrumbSchema([
    { name: "Home", url: business.siteUrl },
    { name: "Areas We Serve", url: `${business.siteUrl}/areas-we-serve` },
    {
      name: `${area.city}, ${area.stateAbbr}`,
      url: `${business.siteUrl}/service-area/${area.slug}`,
    },
  ]),
  ...(faqsOnPage.length > 0 ? [faqPageSchema(faqsOnPage)] : []),
];
---

<BaseLayout
  title={area.seoTitle}
  description={area.metaDescription}
  schema={schemas}
>
  <SectionList
    sections={areaLayout(area)}
    source={`src/content/service-areas/${area.slug}.json`}
    context={{ area }}
  />
</BaseLayout>
