---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicePageBody from "../components/ServicePageBody.astro";
import { services, type Service } from "../data/services";
import { shownFaqs } from "../data/faq-sections";
import { serviceLayout } from "../data/layouts";
import {
  serviceSchema,
  breadcrumbSchema,
  faqPageSchema,
} from "../data/schema";
import { business } from "../data/business";

// One page per service in src/content/services (e.g. /airboat-tours).
export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as { service: Service };

// FAQ markup lists exactly the questions shown on the page.
const faqsOnPage = shownFaqs(serviceLayout(service), service.slug);

const schemas = [
  serviceSchema(service),
  breadcrumbSchema([
    { name: "Home", url: business.siteUrl },
    { name: service.shortName, url: `${business.siteUrl}/${service.slug}` },
  ]),
  ...(faqsOnPage.length > 0 ? [faqPageSchema(faqsOnPage)] : []),
];
---

<BaseLayout
  title={service.seoTitle}
  description={service.metaDescription}
  schema={schemas}
>
  <ServicePageBody service={service} />
</BaseLayout>
