---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicePageBody from "../components/ServicePageBody.astro";
import { getService } from "../data/services";
import { getServiceFaqs } from "../data/faqs";
import {
  serviceSchema,
  breadcrumbSchema,
  faqPageSchema,
} from "../data/schema";
import { business } from "../data/business";

const service = getService("airboat-tours")!;

const schemas = [
  serviceSchema(service),
  breadcrumbSchema([
    { name: "Home", url: business.siteUrl },
    { name: service.shortName, url: `${business.siteUrl}/${service.slug}` },
  ]),
  faqPageSchema(getServiceFaqs(service.slug)),
];
---

<BaseLayout
  title={service.seoTitle}
  description={service.metaDescription}
  schema={schemas}
>
  <ServicePageBody service={service} />
</BaseLayout>
